<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.es.mapper.ProductsMapper">

    <resultMap id="BaseResultMap" type="com.example.es.entity.Products">
            <id property="id" column="id" />
            <result property="merchant_id" column="merchant_id" />
            <result property="category_id" column="category_id" />
            <result property="product_name" column="product_name" />
            <result property="product_code" column="product_code" />
            <result property="main_image" column="main_image" />
            <result property="description" column="description" />
            <result property="detail_content" column="detail_content" />
            <result property="base_price" column="base_price" />
            <result property="sale_status" column="sale_status" />
            <result property="audit_status" column="audit_status" />
            <result property="created_at" column="created_at" />
            <result property="updated_at" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,merchant_id,category_id,product_name,product_code,main_image,
        description,detail_content,base_price,sale_status,audit_status,
        created_at,updated_at
    </sql>
</mapper>
