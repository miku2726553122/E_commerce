<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.es.mapper.ProductsMapper">

    <resultMap id="BaseResultMap" type="com.example.es.entity.Products">
            <id property="id" column="id" />
            <result property="merchantId" column="merchant_id" />
            <result property="categoryId" column="category_id" />
            <result property="productName" column="product_name" />
            <result property="productCode" column="product_code" />
            <result property="mainImage" column="main_image" />
            <result property="description" column="description" />
            <result property="detailContent" column="detail_content" />
            <result property="basePrice" column="base_price" />
            <result property="saleStatus" column="sale_status" />
            <result property="auditStatus" column="audit_status" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id,merchant_id,category_id,product_name,product_code,main_image,
        description,detail_content,base_price,sale_status,audit_status,
        created_at,updated_at
    </sql>
</mapper>
